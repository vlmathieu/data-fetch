"""data-fetch: dated, traceable data downloads.

Source present: UN Comtrade. The repo is built to take others. One source is
one rules file plus one config block, without touching the rest: see the
contract at the top of rules/common.smk.

Assembly only. The derivation config -> params -> fingerprint -> stem ->
targets lives in each source's `plan()`, in workflow/scripts/, where a
`_demo()` can test it.
"""

from snakemake.utils import min_version

min_version("8.16.0")

configfile: "config/config.yaml"

# Order matters: common.smk sets up sys.path and RUN_ID, which every source
# needs, and declares the TARGETS list they append to.
include: "rules/common.smk"
include: "rules/comtrade.smk"


rule all:
    # Declared AFTER the includes, so TARGETS is complete by now. Without this
    # directive Snakemake would take the first rule it parsed as the default
    # target, which would be comtrade_preflight.
    default_target: True
    input:
        TARGETS
