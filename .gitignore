# Downloaded data: never versioned (large, timestamped, regenerable)
data/
!data/**/.gitkeep

# Snakemake state: holds rule params, so potentially secrets
.snakemake/
workflow/logs/*
!workflow/logs/.gitkeep
workflow/benchmarks/

# Secrets
.env
*.key

# Python
__pycache__/
*.py[cod]
.venv/

# OS / editors
.DS_Store
.vscode/settings.json
